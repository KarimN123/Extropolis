# --- Base de données / cache ---
DATABASE_URL="postgresql://extropolis:extropolis@localhost:5432/extropolis?schema=public"
# Rôle applicatif soumis au RLS (voir apps/api/prisma/migrations/*_rls)
APP_DATABASE_URL="postgresql://extropolis_app:extropolis_app@localhost:5432/extropolis?schema=public"
REDIS_URL="redis://localhost:6379"

# --- API ---
API_PORT=4000
PLATFORM_DOMAIN="localhost:3000"
PUBLIC_API_URL="http://localhost:4000"
JWT_SECRET="dev-only-change-me"

# --- Stripe (rail international) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- PSP local (rail mobile money : Wave / Orange Money) ---
# "sandbox" : simulateur intégré, aucun appel réseau. "paydunya" : Wave/OM/Free/Moov.
LOCAL_PSP_PROVIDER="sandbox"
PAYDUNYA_MODE="test"           # test | live
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_TOKEN=""
PAYDUNYA_WEBHOOK_SECRET=""

# --- Plateforme ---
PLATFORM_FEE_BPS=250           # 2,50 % par transaction
PLATFORM_STORE_NAME="Extropolis"

# --- Front (apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_DEFAULT_TENANT="mamalys"
